# .env.example → .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 는 .gitignore 에 들어 있다. 키는 코드에 적지 않는다 (NF3001).

# ── ① ② 큐넷 (한국산업인력공단) ───────────────────────────────────
# 레거시 엔드포인트 openapi.q-net.or.kr 는 2026-11-18 현재 키 없이 응답한다. 비워 둬도 된다.
# 막힐 때를 대비해 data.go.kr 에서 '한국산업인력공단_국가자격 시험일정' 활용신청 후 Decoding 키를 넣는다.
QNET_SERVICE_KEY=

# ── 공공데이터포털 공통 키 (자동변환 API: 데이터진흥원 SQLD·ADsP·빅분기 등) ──
# data.go.kr 마이페이지 > 인증키 의 '일반 인증키'. data/sources.json 의 odcloud 출처가 쓴다.
DATA_GO_KR_KEY=

# ── ③ 책 검색 — 카카오 ──────────────────────────────────────────
# 카카오: developers.kakao.com → 내 애플리케이션 → 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# ── 네이버 클라우드 NAVER API HUB (선택 — 지식백과 · 블로그) ─────────
# console.ncloud.com → NAVER API HUB → 검색(백과사전 · 블로그) 이용 신청 → API Key ID / Key
# RAG 수집(scripts/collect_naver.py) 과 분야에 없는 직무의 근거 찾기(네이버 글에 함께 나온 자격)에 쓴다
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=

# ── LLM: SSAFY GMS (OpenAI 호환) ──────────────────────────────────
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_MODEL=gpt-4.1-mini

# ── 실행 설정 ─────────────────────────────────────────────────────
REPLAN_LIMIT=2

# ── 캘린더 (심화 F3023) ──────────────────────────────────────────
# local: 서버 SQLite (기본) · google: Google Calendar (data/google/credentials.json + scripts/google_login.py)
CALENDAR_BACKEND=local

# 커리어넷 직업정보 Open API (career.go.kr — 신청 · 승인 후 발급). 직업의 하는 일 · 되는 길 · 관련 자격
CAREERNET_API_KEY=
